# Скопируй в .env и заполни. Файл .env в гит не попадает.

# Telegram. Получить: https://my.telegram.org → API development tools.
# Заводи отдельный номер под сбор: автоматизацию на основном аккаунте
# Telegram может воспринять плохо.
TG_API_ID=
TG_API_HASH=

# Ключ Anthropic для разбора постов. https://console.anthropic.com
ANTHROPIC_API_KEY=

# Необязательное — значения по умолчанию подходят для старта.
# KSA_PARSE_MODEL=claude-opus-5
# KSA_PARSE_EFFORT=low
# KSA_DB=data/ksa.db
